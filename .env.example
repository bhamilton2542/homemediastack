# Copy this file to .env and fill in your own real values.
# .env itself is gitignored -- never commit real secrets.

# General
TZ=America/Phoenix
PUID=501
PGID=20

# Paths -- adjust for your own system
MEDIA_PATH=/Volumes/Plex
DOWNLOADS_PATH=/Users/youruser/Downloads
MUSIC_DOWNLOADS_PATH=/Volumes/YourMusicDrive/downloads

# Homepage
HOMEPAGE_ALLOWED_HOSTS=yourdomain.com,192.168.1.100:3000,localhost:3000

# Clan About / Clan Vote -- generate real random values, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CLAN_ABOUT_SECRET_KEY=
CLAN_VOTE_SECRET_KEY=
DISCORD_WEBHOOK_URL=
DISCORD_NEW_VOTE_WEBHOOK_URL=

# Mealie
MEALIE_BASE_URL=http://192.168.1.100:9925
MEALIE_API_TOKEN=
MEALIE_SHOPPING_LIST_ID=
